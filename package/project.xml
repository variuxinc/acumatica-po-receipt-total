<Customization level="" description="Shows the Total Cost box on Purchase Receipts (PO302000). Variux, Apache-2.0." product-version="25.201">
    <DAC type="PX.Objects.PO.POReceipt">
        <Field FieldName="CuryOrderTotal" TypeName="decimal" TextAttributes="#CDATA" OverrideClassName="PX.Objects.PO.POReceipt" StorageName="ExistingColumn">
            <CDATA name="TextAttributes"><![CDATA[
[PXCustomizeBaseAttribute(typeof(PXUIFieldAttribute), "Visible", true)]]]></CDATA>
        </Field>
    </DAC>
    <!--
    PLACEHOLDER, not yet valid. Replace with the Page element exported from a
    clean 2025 R2 tenant after setting Layout Properties > Visible = True on
    edCuryOrderTotal, then delete its pageSource attribute. Expected shape
    (ParentId, ControlId and TypeFullName values unconfirmed):

    <Page path="~/pages/po/po302000.aspx">
        <PXNumberEdit ID="edCuryOrderTotal" ParentId="(from export)" TypeFullName="PX.Web.UI.PXNumberEdit">
            <Prop Key="Visible" Value="True" />
        </PXNumberEdit>
    </Page>
    -->
</Customization>
